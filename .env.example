# --- External Python Backend --------------------------------------------------
# URL of the Python backend (FastAPI / WebSocket server).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# --- Google Auth (Better Auth) -----------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Mock Mode Switch ---------------------------------------------------------
# Set to 'true' to use client-side mocks if the Python backend is not running yet.
NEXT_PUBLIC_USE_MOCKS=true
MOCK_DELAY_MS=250

# NOTE: Never put Rime API keys or LLM keys here — these live only in the Python backend's env.
